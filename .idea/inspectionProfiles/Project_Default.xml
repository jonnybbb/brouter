<component name="InspectionProjectProfileManager">
  <profile version="1.0">
    <option name="myName" value="Project Default" />
    <!--
      Project inspection profile for the code-review inspector and the IDE.
      Pure-style inspections that the cross-file review explicitly de-emphasizes
      are disabled here so inspector runs stay high-signal. Re-enable in the IDE
      (Settings -> Editor -> Inspections) if you want them locally.
    -->
    <inspection_tool class="CanBeFinal" enabled="false" level="WARNING" enabled_by_default="false" />
  </profile>
</component>
